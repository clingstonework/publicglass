---
layout: base.njk
title: Contracts
---

<h1>Government Contracts</h1>
<p class="lead">Federal government contracts for FY{{ contracts.fy }} via <a href="https://www.tenders.gov.au" style="color:#2E6B9E">AusTender</a>.</p>

{% if contracts %}
<p style="font-family:system-ui,sans-serif;font-size:0.85rem;color:#666;margin-bottom:2rem;">
  {{ contracts.total }} contracts · Data fetched {{ contracts.fetched_at | replace("T"," ") | replace("Z"," UTC") }}
</p>

{% for month in contracts.months %}
<details {% if loop.first %}open{% endif %} style="margin-bottom:1.5rem;border:1px solid #dde3ea;border-radius:6px;overflow:hidden;">

  <summary style="cursor:pointer;padding:0.75rem 1rem;background:#f5f7fa;list-style:none;display:flex;align-items:baseline;gap:1rem;user-select:none;">
    <span style="font-family:system-ui,sans-serif;font-size:1rem;font-weight:700;color:#1C3D5A;">{{ month.label }}</span>
    <span style="font-family:system-ui,sans-serif;font-size:0.85rem;color:#555;">
      {{ month.count }} contracts &nbsp;·&nbsp; {{ month.total_value | formatMoney }} total
      {% if month.contracts | length < month.count %}
        &nbsp;·&nbsp; showing top {{ month.contracts | length }} by value
      {% endif %}
    </span>
    <span style="margin-left:auto;font-size:0.8rem;color:#888;">▼</span>
  </summary>

  <div style="overflow-x:auto;padding:0.5rem 0;">
  <table style="width:100%;border-collapse:collapse;font-family:system-ui,sans-serif;font-size:0.85rem;">
    <thead>
      <tr style="text-align:left;background:#f9fafb;border-bottom:1px solid #dde3ea;">
        <th style="padding:0.4rem 0.75rem;color:#1C3D5A;font-weight:600;">Title</th>
        <th style="padding:0.4rem 0.75rem;color:#1C3D5A;font-weight:600;">Agency</th>
        <th style="padding:0.4rem 0.75rem;color:#1C3D5A;font-weight:600;">Supplier</th>
        <th style="padding:0.4rem 0.75rem;color:#1C3D5A;font-weight:600;text-align:right;">Value (AUD)</th>
        <th style="padding:0.4rem 0.75rem;color:#1C3D5A;font-weight:600;">Published</th>
      </tr>
    </thead>
    <tbody>
      {% for contract in month.contracts %}
      <tr style="border-bottom:1px solid #eee;">
        <td style="padding:0.5rem 0.75rem;max-width:280px;">
          {% if contract.url_id %}<a href="https://www.tenders.gov.au/Cn/Show/{{ contract.url_id }}" style="color:#2E6B9E;text-decoration:none;" target="_blank" rel="noopener">{{ contract.title | truncate(80) }}</a>{% else %}{{ contract.title | truncate(80) }}{% endif %}
        </td>
        <td style="padding:0.5rem 0.75rem;max-width:160px;">{{ contract.agency | truncate(40) }}</td>
        <td style="padding:0.5rem 0.75rem;max-width:160px;">{{ contract.supplier | truncate(40) }}</td>
        <td style="padding:0.5rem 0.75rem;text-align:right;font-variant-numeric:tabular-nums;">
          {% if contract.value_aud %}{{ contract.value_aud | formatMoney }}{% endif %}
        </td>
        <td style="padding:0.5rem 0.75rem;white-space:nowrap;">{{ contract.published }}</td>
      </tr>
      {% endfor %}
    </tbody>
  </table>
  </div>

</details>
{% endfor %}

{% else %}
<p>Contract data not yet available. Check back soon.</p>
{% endif %}
